    {
      "name": "logging_toolbox.LoggingToolbox.line_break",
      "description": "Logs a universal seperator that can have its width adjusted as needed.",
      "parameters": [
        {
          "name": "message_level",
          "type": "str",
          "description": "debug, info, warning, error, critical, exception",
          "default_value": "info"
        },
        {
          "name": "width",
          "type": "int",
          "description": "Defaults to 30 character width, can be adjusted as needed.",
          "default_value": "_DEFAULT_CONSOLE_WIDTH"
        },
        {
          "name": "char",
          "type": "str",
          "description": "",
          "default_value": "="
        }
      ],
      "returns": {
        "type": "Any",
        "description": ""
      }
    },
    {
      "name": "logging_toolbox.LoggingToolbox.line_wrap",
      "description": "Logs a wrapped output of a log message.",
      "parameters": [
        {
          "name": "message_string",
          "type": "str",
          "description": "The message to be wrapped."
        },
        {
          "name": "message_level",
          "type": "str",
          "description": "debug, info, warning, error, critical, exception",
          "default_value": "info"
        },
        {
          "name": "max_width",
          "type": "int",
          "description": "Defaults to 30 character width, can be adjusted as needed.",
          "default_value": "_DEFAULT_CONSOLE_WIDTH"
        },
        {
          "name": "offset_left",
          "type": "int",
          "description": "Defaults to 0, can be adjusted as needed.",
          "default_value": "0"
        }
